generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Student {
  id                           Int                            @id @default(autoincrement())
  role                         Role                           @default(APPLICANT)
  subjectsChosen               String[]                       @default(["Subjects Chosen Not available"])
  subjectRelated               String[]                       @default(["Options Not available"])
  createdAt                    DateTime                       @default(now())
  updatedAt                    DateTime                       @updatedAt
  isActive                     Boolean                        @default(false)
  isAllowedLogin               Boolean                        @default(false)
  akaalId                      Int?
  attendancePercentageValue    Int                            @default(0)
  termAttendance               Int                            @default(0)
  currentInvoiceDue            Int?
  hasOverDue                   Boolean?                       @default(false)
  overDue                      Int?
  creditBalance                Int                            @default(0)
  hasSeenNewApplication        Boolean                        @default(false)
  applicationStatus            String?
  previousTermAttendance       Int                            @default(0)
  AlumniRemarks                AlumniRemarks[]
  AutomatedMailForParents      AutomatedMailForParents[]
  comment                      Comment[]
  EmailContent                 EmailContent[]
  emergencyContact             EmergencyContact?
  enrollments                  Enrollment[]
  feedback                     Feedback[]
  GroupClasswork               GroupClasswork[]
  GroupHomework                GroupHomework[]
  healthInformation            HealthInformation?
  interaction                  Interaction[]
  Leave                        Leave[]
  Notification                 Notification[]
  otherInformation             OtherInformation?
  parentsDetails               ParentsDetails?
  personalDetails              PersonalDetails?
  schoolCheckInAttendance      SchoolCheckInAttendance[]
  skipReport                   SkipReport[]
  studentAdminMessage          StudentAdminMessage[]
  studentClassAssignment       StudentClassAssignment[]
  studentClasswork             StudentClasswork[]
  studentHomework              StudentHomework[]
  StudentNoticeAcknowledgement StudentNoticeAcknowledgement[]
  StudentTermAttendanceHistory StudentTermAttendanceHistory[]
  studentTermFee               StudentTermFee[]
  studentProfileActivity      StudentProfileActivity[]
  DeviceToken                  DeviceToken[]
  user                         User?
}

model StudentProfileActivity {
  id                 Int       @id @default(autoincrement())
  studentId          Int
  actionType         String
  description        String
  metadata           Json?
  performedByUserId  Int?
  performedByEmail   String
  createdAt          DateTime  @default(now())
  student            Student   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  performedBy        User?     @relation(fields: [performedByUserId], references: [id], onDelete: SetNull)
}

model StudentTermAttendanceHistory {
  id             Int      @id @default(autoincrement())
  studentId      Int
  termId         Int
  termName       String
  termAttendance Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  student        Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  term           Term     @relation(fields: [termId], references: [id], onDelete: Cascade)

  @@unique([studentId, termId])
}

model PersonalDetails {
  id          Int      @id @default(autoincrement())
  studentId   Int      @unique
  firstName   String
  lastName    String
  DOB         DateTime
  gender      String
  email       String
  contact     String
  address     String
  suburb      String
  state       String
  country     String   @default("Australia")
  postcode    String
  image       String?
  punjabiName String?
  student     Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
}

model ParentsDetails {
  id            Int     @id @default(autoincrement())
  fatherName    String
  motherName    String
  parentEmail   String
  parentContact String
  studentId     Int     @unique
  student       Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
}

model EmergencyContact {
  id            Int     @id @default(autoincrement())
  contactPerson String  @default("Not given")
  contactNumber String
  relationship  String
  studentId     Int     @unique
  student       Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
}

model HealthInformation {
  id                        Int     @id @default(autoincrement())
  medicareNumber            String? @default("Medicare Number not provided")
  ambulanceMembershipNumber String?
  medicalCondition          String
  allergy                   String
  studentId                 Int     @unique
  student                   Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
}

model OtherInformation {
  id          Int      @id @default(autoincrement())
  otherInfo   String   @default("No information provided")
  declaration String[] @default([""])
  studentId   Int      @unique
  student     Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
}

model Subject {
  id                      Int                       @id @default(autoincrement())
  name                    String                    @unique
  isActive                Boolean                   @default(true)
  Classwork               Classwork[]
  Homework                Homework[]
  TeacherSubject          TeacherSubject[]
  termSubject             TermSubject[]
  termSubjectGroupSubject TermSubjectGroupSubject[]
  termSubjectLevel        TermSubjectLevel[]
  termSubjectGroup        TermSubjectGroup[]        @relation("SubjectToTermSubjectGroup")
}

model SubjectGroup {
  id                      Int                       @id @default(autoincrement())
  isActive                Boolean                   @default(true)
  groupName               String                    @unique
  termSubjectGroup        TermSubjectGroup[]
  termSubjectGroupSubject TermSubjectGroupSubject[]
}

model Term {
  id                           Int                            @id @default(autoincrement())
  isPublish                    Boolean                        @default(false)
  currentTerm                  Boolean                        @default(false)
  name                         String                         @unique
  startDate                    DateTime
  endDate                      DateTime
  createdAt                    DateTime                       @default(now())
  updatedAt                    DateTime                       @updatedAt
  automatedAttendanceEnabled   Boolean                        @default(false)
  FeeDashboard                 FeeDashboard[]
  FeeTemplate                  FeeTemplate[]
  StudentTermAttendanceHistory StudentTermAttendanceHistory[]
  studentTermFee               StudentTermFee[]
  termSubject                  TermSubject[]
  termSubjectGroup             TermSubjectGroup[]
  termSubjectGroupSubject      TermSubjectGroupSubject[]
  termSubjectLevel             TermSubjectLevel[]
}

model Level {
  id               Int                @id @default(autoincrement())
  isActive         Boolean            @default(true)
  name             String             @unique
  TermSubjectLevel TermSubjectLevel[]
  termSubject      TermSubject[]      @relation("LevelToTermSubject")
}

model Section {
  id                      Int                       @id @default(autoincrement())
  name                    String                    @unique
  AutomatedMailForParents AutomatedMailForParents[]
  Classwork               Classwork[]
  GroupClasswork          GroupClasswork[]
  GroupHomework           GroupHomework[]
  Homework                Homework[]
  Notification            Notification[]
  StudentClassAssignment  StudentClassAssignment[]
  TeacherClassAssignment  TeacherClassAssignment[]
  TimetableSlot           TimetableSlot[]
  termSubjectLevel        TermSubjectLevel[]        @relation("SectionToTermSubjectLevel")
}

model TermSubjectGroup {
  id                      Int                       @id @default(autoincrement())
  termId                  Int
  feeId                   Int?
  subjectGroupId          Int
  enrollment              Enrollment[]
  FeeTemplate             FeeTemplate[]
  studentTermFee          StudentTermFee[]
  termSubject             TermSubject[]
  fee                     Fee?                      @relation(fields: [feeId], references: [id], onDelete: Cascade)
  subjectGroup            SubjectGroup              @relation(fields: [subjectGroupId], references: [id])
  term                    Term                      @relation(fields: [termId], references: [id], onDelete: Cascade)
  termSubjectGroupSubject TermSubjectGroupSubject[]
  subject                 Subject[]                 @relation("SubjectToTermSubjectGroup")

  @@unique([termId, subjectGroupId])
}

model TermSubject {
  id                 Int                 @id @default(autoincrement())
  termSubjectGroupId Int
  subjectId          Int
  termId             Int
  isOnSunday         Boolean             @default(false)
  isOnWeekday        Boolean             @default(false)
  subjectEnrollments SubjectEnrollment[]
  subject            Subject             @relation(fields: [subjectId], references: [id])
  term               Term                @relation(fields: [termId], references: [id], onDelete: Cascade)
  termSubjectGroup   TermSubjectGroup    @relation(fields: [termSubjectGroupId], references: [id])
  level              Level[]             @relation("LevelToTermSubject")

  @@unique([termId, subjectId, termSubjectGroupId])
}

model TermSubjectLevel {
  id                      Int                       @id @default(autoincrement())
  termId                  Int
  subjectId               Int
  levelId                 Int
  AutomatedMailForParents AutomatedMailForParents[]
  Classwork               Classwork[]
  enrollments             Enrollment[]
  Feedback                Feedback[]
  GroupClasswork          GroupClasswork[]
  GroupHomework           GroupHomework[]
  Homework                Homework[]
  Notification            Notification[]
  studentClassAssignment  StudentClassAssignment[]
  teacherClassAssignment  TeacherClassAssignment[]
  level                   Level                     @relation(fields: [levelId], references: [id])
  subject                 Subject                   @relation(fields: [subjectId], references: [id])
  term                    Term                      @relation(fields: [termId], references: [id])
  TimetableSlot           TimetableSlot[]
  sections                Section[]                 @relation("SectionToTermSubjectLevel")

  @@unique([termId, subjectId, levelId])
}

model StudentClassAssignment {
  id                     Int               @id @default(autoincrement())
  enrollmentId           Int
  studentId              Int
  termSubjectLevelId     Int
  sectionId              Int
  isCurrentlyAssigned    Boolean           @default(true)
  changeDate             DateTime          @default(now())
  note                   String?
  migratedToAssignmentId Int?
  migratedAt             DateTime?
  classAttendance        ClassAttendance[]
  enrollment             Enrollment        @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  section                Section           @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  student                Student           @relation(fields: [studentId], references: [id], onDelete: Cascade)
  termSubjectLevel       TermSubjectLevel  @relation(fields: [termSubjectLevelId], references: [id], onDelete: Cascade)

  @@unique([studentId, termSubjectLevelId, isCurrentlyAssigned, sectionId])
}

model Enrollment {
  id                      Int                       @id @default(autoincrement())
  studentId               Int
  dueDate                 DateTime?
  termSubjectGroupId      Int
  subjectEnrollmentId     Int?                      @unique
  createdAt               DateTime                  @default(now())
  termSubjectLevelId      Int?
  updatedAt               DateTime?                 @updatedAt
  student                 Student                   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  termSubjectGroup        TermSubjectGroup          @relation(fields: [termSubjectGroupId], references: [id])
  termSubjectLevel        TermSubjectLevel?         @relation(fields: [termSubjectLevelId], references: [id])
  studentClassAssignment  StudentClassAssignment[]
  subjectEnrollment       SubjectEnrollment?
  termSubjectGroupSubject TermSubjectGroupSubject[]

  @@unique([studentId, termSubjectGroupId, subjectEnrollmentId])
}

model SubjectEnrollment {
  id            Int         @id @default(autoincrement())
  enrollmentId  Int         @unique
  termSubjectId Int
  grade         String      @default("No Grades yet")
  enrollment    Enrollment  @relation(fields: [enrollmentId], references: [id])
  termSubject   TermSubject @relation(fields: [termSubjectId], references: [id])

  @@unique([enrollmentId, termSubjectId])
}

model Fee {
  id               Int                @id @default(autoincrement())
  amount           Int
  paymentType      PaymentType
  feePayment       FeePayment[]
  termSubjectGroup TermSubjectGroup[]

  @@unique([amount, paymentType])
}

model StudentTermFee {
  id                 Int              @id @default(autoincrement())
  studentId          Int
  termSubjectGroupId Int
  termId             Int
  createdAt          DateTime         @default(now())
  feePayment         FeePayment[]
  student            Student          @relation(fields: [studentId], references: [id])
  term               Term             @relation(fields: [termId], references: [id])
  termSubjectGroup   TermSubjectGroup @relation(fields: [termSubjectGroupId], references: [id])

  @@unique([studentId, termSubjectGroupId, termId])
}

model PaymentInstallment {
  id                  Int           @id @default(autoincrement())
  feePaymentId        Int
  paidAmount          Int           @default(0)
  paidDate            DateTime?
  paymentMethod       PaymentMethod @default(NA)
  paymentStatus       PaymentStatus @default(PENDING)
  remarks             String        @default("No remarks")
  receivedBy          String?
  createdAt           DateTime      @default(now())
  errorDetails        String?
  isTransactionSucess Boolean       @default(true)
  transactionId       String?
  updatedAt           DateTime?     @updatedAt
  feePayment          FeePayment    @relation(fields: [feePaymentId], references: [id])

  @@index([feePaymentId])
}

model FeePayment {
  id                 Int                  @id @default(autoincrement())
  feeId              Int?
  dueDate            DateTime
  paidDate           DateTime?
  dueAmount          Int
  studentTermFeeId   Int?
  status             PaymentStatus?
  method             PaymentMethod?
  amountPaid         Int?
  /// /moved to  PaymentInstallment
  remarks            String?
  /// not required- moved to student model
  creditAmount       Int                  @default(0)
  feeAmount          Int?
  createdAt          DateTime?            @default(now())
  adjustedFeeAmount  Int?
  discountAmount     Int?                 @default(0)
  discountReason     String?
  hasDiscount        Boolean?             @default(false)
  hasDue             Boolean?             @default(true)
  hasOverDue         Boolean?             @default(false)
  invoiceId          String?              @default("0000_0_0")
  isActive           Boolean?             @default(true)
  updatedAt          DateTime?            @updatedAt
  feeTemplateId      Int?
  fee                Fee?                 @relation(fields: [feeId], references: [id])
  feeTemplate        FeeTemplate?         @relation(fields: [feeTemplateId], references: [id], onDelete: Cascade)
  studentTermFee     StudentTermFee?      @relation(fields: [studentTermFeeId], references: [id], onDelete: Cascade)
  paymentInstallment PaymentInstallment[]
}

model FeeTemplate {
  id                 Int               @id @default(autoincrement())
  invoiceName        String
  groupName          String
  month              String
  year               String
  termName           String
  amount             Int
  dueDate            DateTime
  notes              String            @default("No notes")
  interval           PaymentType
  termId             Int?
  termSubjectGroupId Int?
  updatedAt          DateTime          @updatedAt
  createdAt          DateTime          @default(now())
  lastCronJobRun     DateTime?
  feePayments        FeePayment[]
  term               Term?             @relation(fields: [termId], references: [id])
  termSubjectGroup   TermSubjectGroup? @relation(fields: [termSubjectGroupId], references: [id])

  @@unique([invoiceName, dueDate, groupName, interval])
}

model FeeDashboard {
  id                   Int      @id @default(autoincrement())
  totalFeesInvoiced    Int      @default(0)
  totalFeesPaid        Int      @default(0)
  totalFeesDue         Int      @default(0)
  totalFeesOverdue     Int      @default(0)
  totalFeesOverduePrev Int      @default(0)
  termId               Int
  updatedAt            DateTime @updatedAt
  createdAt            DateTime @default(now())
  term                 Term     @relation(fields: [termId], references: [id])

  @@unique([termId, createdAt])
}

model TermSubjectGroupSubject {
  id                 Int               @id @default(autoincrement())
  termId             Int
  subjectGroupId     Int
  termSubjectGroupId Int?
  enrollmentId       Int?
  subjectId          Int
  enrollment         Enrollment?       @relation(fields: [enrollmentId], references: [id])
  subjectGroup       SubjectGroup      @relation(fields: [subjectGroupId], references: [id])
  subject            Subject           @relation(fields: [subjectId], references: [id])
  term               Term              @relation(fields: [termId], references: [id], onDelete: Cascade)
  termSubjectGroup   TermSubjectGroup? @relation(fields: [termSubjectGroupId], references: [id], onDelete: Cascade)

  @@unique([termId, subjectGroupId, subjectId])
}

model TimeTable {
  id         Int      @id @default(autoincrement())
  name       String?  @default("Timetable")
  isActive   Boolean  @default(true)
  data       Json
  updatedAt  DateTime @updatedAt
  createdAt  DateTime @default(now())
  termId     Int?
  totalRooms Int      @default(6)
  roomNames  String[] @default([])
}

model Teacher {
  id                               Int                               @id @default(autoincrement())
  role                             Role                              @default(APPLICANT)
  isActive                         Boolean                           @default(false)
  isAllowedLogin                   Boolean                           @default(false)
  createdAt                        DateTime                          @default(now())
  updatedAt                        DateTime                          @updatedAt
  AutomatedMailForParents          AutomatedMailForParents[]
  Classwork                        Classwork[]
  feedback                         Feedback[]
  GroupClasswork                   GroupClasswork[]
  GroupHomework                    GroupHomework[]
  Homework                         Homework[]
  NoticeAcknowledgement            NoticeAcknowledgement[]
  skipReport                       SkipReport[]
  teacherBankDetails               TeacherBankDetails?
  teacherSubjectAssignment         TeacherClassAssignment[]
  teacherEmergencyContact          TeacherEmergencyContact?
  teacherOtherInformation          TeacherOtherInformation?
  teacherPersonalDetails           TeacherPersonalDetails?
  teacherQualificationAvailability TeacherQualificationAvailability?
  teacherSubject                   TeacherSubject[]
  teacherWWCHealthInformation      TeacherWWCHealthInformation?
  teacherWorkRights                TeacherWorkRights?
  TimetableSlot                    TimetableSlot[]
  user                             User?
}

model TeacherPersonalDetails {
  id        Int      @id @default(autoincrement())
  teacherId Int      @unique
  firstName String
  lastName  String
  DOB       DateTime
  gender    String
  email     String   @unique
  contact   String
  address   String
  suburb    String
  state     String
  country   String
  postcode  String
  image     String?
  teacher   Teacher  @relation(fields: [teacherId], references: [id], onDelete: Cascade)
}

model TeacherEmergencyContact {
  id            Int     @id @default(autoincrement())
  teacherId     Int     @unique
  contactPerson String
  contactNumber String
  relationship  String
  teacher       Teacher @relation(fields: [teacherId], references: [id], onDelete: Cascade)
}

model TeacherWWCHealthInformation {
  id                                     Int      @id @default(autoincrement())
  medicareNumber                         String?  @default("Medicare Number not provided")
  medicalCondition                       String
  childrenCheckCardNumber                String   @unique
  workingWithChildrenCheckExpiry         DateTime
  teacherId                              Int      @unique
  workingwithChildrenCheckCardPhotoImage String?
  teacher                                Teacher  @relation(fields: [teacherId], references: [id], onDelete: Cascade)
}

model TeacherWorkRights {
  id                Int     @id @default(autoincrement())
  workRights        Boolean
  immigrationStatus String
  teacherId         Int     @unique
  teacher           Teacher @relation(fields: [teacherId], references: [id], onDelete: Cascade)
}

model TeacherQualificationAvailability {
  id              Int      @id @default(autoincrement())
  qualification   String
  subjectsChosen  String[]
  timeSlotsChosen String[]
  teacherId       Int      @unique
  experience      String
  teacher         Teacher  @relation(fields: [teacherId], references: [id], onDelete: Cascade)
}

model TeacherBankDetails {
  id              Int     @id @default(autoincrement())
  bankAccountName String
  BSB             String
  accountNumber   String
  ABN             String? @default("NA")
  teacherId       Int     @unique
  teacher         Teacher @relation(fields: [teacherId], references: [id], onDelete: Cascade)
}

model TeacherOtherInformation {
  id        Int     @id @default(autoincrement())
  otherInfo String  @default("No information provided")
  teacherId Int     @unique
  teacher   Teacher @relation(fields: [teacherId], references: [id], onDelete: Cascade)
}

model TeacherSubject {
  id        Int     @id @default(autoincrement())
  teacherId Int
  subjectId Int
  subject   Subject @relation(fields: [subjectId], references: [id])
  teacher   Teacher @relation(fields: [teacherId], references: [id], onDelete: Cascade)

  @@unique([teacherId, subjectId])
}

model TeacherClassAssignment {
  id                 Int              @id @default(autoincrement())
  teacherId          Int
  termSubjectLevelId Int
  sectionId          Int
  timeSlot           String?
  section            Section          @relation(fields: [sectionId], references: [id])
  teacher            Teacher          @relation(fields: [teacherId], references: [id])
  termSubjectLevel   TermSubjectLevel @relation(fields: [termSubjectLevelId], references: [id])

  @@unique([teacherId, termSubjectLevelId, sectionId])
}

model Admin {
  id                                  Int                                   @id @default(autoincrement())
  role                                Role                                  @default(ADMIN)
  isActive                            Boolean                               @default(true)
  isAllowedLogin                      Boolean                               @default(true)
  createdAt                           DateTime                              @default(now())
  updatedAt                           DateTime                              @updatedAt
  adminBankDetails                    AdminBankDetails?
  adminEmergencyContact               AdminEmergencyContact?
  AdminFeedbackOption                 AdminFeedbackOption[]
  adminOtherInformation               AdminOtherInformation?
  adminPersonalDetails                AdminPersonalDetails?
  adminWWCHealthInformation           AdminWWCHealthInformation?
  adminWorkRights                     AdminWorkRights?
  Classwork                           Classwork[]
  comment                             Comment[]
  EmailTemplate                       EmailTemplate[]
  EnrollmentConfirmationEmailTemplate EnrollmentConfirmationEmailTemplate[]
  Homework                            Homework[]
  Leave                               Leave[]
  Notice                              Notice[]
  SkipReport                          SkipReport[]
  StudentAdminMessage                 StudentAdminMessage[]
  StudentNotice                       StudentNotice[]
  user                                User?
}

model AdminPersonalDetails {
  id        Int      @id @default(autoincrement())
  adminId   Int      @unique
  firstName String
  lastName  String
  DOB       DateTime
  gender    String
  email     String   @unique
  contact   String   @unique
  address   String
  suburb    String
  state     String
  country   String
  postcode  String
  image     String?
  admin     Admin    @relation(fields: [adminId], references: [id], onDelete: Cascade)
}

model AdminEmergencyContact {
  id            Int    @id @default(autoincrement())
  adminId       Int    @unique
  contactPerson String
  contactNumber String
  relationship  String
  admin         Admin  @relation(fields: [adminId], references: [id], onDelete: Cascade)
}

model AdminWWCHealthInformation {
  id                                     Int      @id @default(autoincrement())
  adminId                                Int      @unique
  medicareNumber                         String?  @default("Medicare Number not provided")
  medicalCondition                       String
  childrenCheckCardNumber                String   @unique
  workingWithChildrenCheckExpiry         DateTime
  workingwithChildrenCheckCardPhotoImage String?
  admin                                  Admin    @relation(fields: [adminId], references: [id], onDelete: Cascade)
}

model AdminWorkRights {
  id                Int     @id @default(autoincrement())
  adminId           Int     @unique
  workRights        Boolean
  immigrationStatus String
  admin             Admin   @relation(fields: [adminId], references: [id], onDelete: Cascade)
}

model AdminBankDetails {
  id              Int     @id @default(autoincrement())
  adminId         Int     @unique
  bankAccountName String
  BSB             String
  accountNumber   String
  ABN             String? @default("NA")
  admin           Admin   @relation(fields: [adminId], references: [id], onDelete: Cascade)
}

model AdminOtherInformation {
  id        Int    @id @default(autoincrement())
  adminId   Int    @unique
  otherInfo String @default("No information provided")
  admin     Admin  @relation(fields: [adminId], references: [id], onDelete: Cascade)
}

model User {
  id                          Int      @id @default(autoincrement())
  email                       String   @unique
  password                    String
  role                        Role
  createdAt                   DateTime @default(now())
  updatedAt                   DateTime @updatedAt
  isActive                    Boolean  @default(true)
  isEmailVerified             Boolean  @default(false)
  adminId                     Int?     @unique
  studentId                   Int?     @unique
  teacherId                   Int?     @unique
  resetPasswordToken          String?
  resetPasswordTokenExpiresAt Int?
  admin                       Admin?   @relation(fields: [adminId], references: [id], onDelete: Cascade)
  student                     Student? @relation(fields: [studentId], references: [id], onDelete: Cascade)
  teacher                     Teacher? @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  studentProfileActivity      StudentProfileActivity[]
}

model SchoolCheckInAttendance {
  id              Int               @id @default(autoincrement())
  studentId       Int
  date            DateTime
  checkInTime     DateTime?
  remarks         String?
  checkedIn       Boolean           @default(false)
  isMarked        Boolean           @default(false)
  checkOutTime    DateTime?
  isCheckedOut    Boolean?
  schoolDayId     Int?
  attendanceValue Int               @default(0)
  isOnLeave       Boolean           @default(false)
  classAttendance ClassAttendance[]
  SchoolDay       SchoolDay?        @relation(fields: [schoolDayId], references: [id])
  student         Student           @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([studentId, date])
}

model ClassAttendance {
  id                        Int                     @id @default(autoincrement())
  studentClassAssignmentId  Int
  date                      DateTime
  attendanceStatus          AttendanceStatus        @default(ABSENT)
  remarks                   String?                 @default("NA")
  schoolCheckInAttendanceId Int
  schoolDayId               Int?
  schoolCheckInAttendance   SchoolCheckInAttendance @relation(fields: [schoolCheckInAttendanceId], references: [id])
  SchoolDay                 SchoolDay?              @relation(fields: [schoolDayId], references: [id])
  studentClassAssignment    StudentClassAssignment  @relation(fields: [studentClassAssignmentId], references: [id], onDelete: Cascade)

  @@unique([studentClassAssignmentId, date])
}

model SkipReport {
  id                  Int       @id @default(autoincrement())
  studentId           Int
  teacherId           Int?
  date                DateTime
  reason              String
  isClosed            Boolean   @default(false)
  adminClosingRemarks String?
  className           String
  adminId             Int?
  closeDate           DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime? @updatedAt
  admin               Admin?    @relation(fields: [adminId], references: [id], onDelete: Cascade)
  student             Student   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  teacher             Teacher?  @relation(fields: [teacherId], references: [id], onDelete: Cascade)
}

model Homework {
  id                   Int                    @id @default(autoincrement())
  subjectId            Int
  teacherId            Int?
  adminId              Int?
  uploadedUserRole     String
  title                String?                @default("No title")
  description          String
  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt
  attachments          String[]
  termSubjectLevelId   Int?
  sectionId            Int?
  admin                Admin?                 @relation(fields: [adminId], references: [id], onDelete: Cascade)
  section              Section?               @relation(fields: [sectionId], references: [id])
  subject              Subject                @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  teacher              Teacher?               @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  termSubjectLevel     TermSubjectLevel?      @relation(fields: [termSubjectLevelId], references: [id])
  HomeworkSnapshot     HomeworkSnapshot[]
  SentHomeworkSnapshot SentHomeworkSnapshot[]
  StudentHomework      StudentHomework[]
}

model StudentHomework {
  id             Int       @id @default(autoincrement())
  studentId      Int
  homeworkId     Int
  submissionDate DateTime?
  grade          String?
  feedback       String?
  submitted      Boolean   @default(false)
  attachments    String[]
  sendDate       DateTime?
  classTime      String?
  roomName       String?
  className      String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  homework       Homework  @relation(fields: [homeworkId], references: [id], onDelete: Cascade)
  student        Student   @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([studentId, homeworkId])
}

model Feedback {
  id                 Int              @id @default(autoincrement())
  studentId          Int
  teacherId          Int
  content            String
  isSent             Boolean          @default(false)
  sendDate           DateTime         @default(now())
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  title              String
  termSubjectLevelId Int
  className          String?
  classTime          String?
  roomName           String?
  sectionId          Int?
  student            Student          @relation(fields: [studentId], references: [id], onDelete: Cascade)
  teacher            Teacher          @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  termSubjectLevel   TermSubjectLevel @relation(fields: [termSubjectLevelId], references: [id])
}

model GroupHomework {
  id                   Int                    @id @default(autoincrement())
  studentId            Int
  teacherId            Int
  termSubjectLevelId   Int
  title                String
  attachments          String[]
  isSent               Boolean                @default(false)
  sendDate             DateTime               @default(now())
  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt
  description          String[]
  sectionId            Int?
  section              Section?               @relation(fields: [sectionId], references: [id])
  student              Student                @relation(fields: [studentId], references: [id], onDelete: Cascade)
  teacher              Teacher                @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  termSubjectLevel     TermSubjectLevel       @relation(fields: [termSubjectLevelId], references: [id])
  HomeworkSnapshot     HomeworkSnapshot[]
  SentHomeworkSnapshot SentHomeworkSnapshot[]
}

model HomeworkSnapshot {
  id              Int           @id @default(autoincrement())
  homeworkId      Int
  groupHomeworkId Int
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  description     String
  fileNames       String[]
  attachments     String[]
  sendDate        DateTime      @default(now())
  groupHomework   GroupHomework @relation(fields: [groupHomeworkId], references: [id], onDelete: Cascade)
  homework        Homework      @relation(fields: [homeworkId], references: [id], onDelete: Cascade)
}

model SentHomeworkSnapshot {
  id              Int           @id @default(autoincrement())
  homeworkId      Int?
  groupHomeworkId Int
  description     String
  attachments     String[]
  fileNames       String[]
  sendDate        DateTime
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  groupHomework   GroupHomework @relation(fields: [groupHomeworkId], references: [id])
  homework        Homework?     @relation(fields: [homeworkId], references: [id])
}

model Classwork {
  id                    Int                     @id @default(autoincrement())
  subjectId             Int
  teacherId             Int?
  uploadedUserRole      String
  title                 String?                 @default("No title")
  description           String
  attachments           String[]
  dueDate               DateTime                @default(now())
  createdAt             DateTime                @default(now())
  updatedAt             DateTime                @updatedAt
  termSubjectLevelId    Int?
  adminId               Int?
  sectionId             Int?
  admin                 Admin?                  @relation(fields: [adminId], references: [id], onDelete: Cascade)
  section               Section?                @relation(fields: [sectionId], references: [id])
  subject               Subject                 @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  teacher               Teacher?                @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  termSubjectLevel      TermSubjectLevel?       @relation(fields: [termSubjectLevelId], references: [id])
  ClassworkSnapshot     ClassworkSnapshot[]
  SentClassworkSnapshot SentClassworkSnapshot[]
  StudentClasswork      StudentClasswork[]
}

model StudentClasswork {
  id             Int       @id @default(autoincrement())
  studentId      Int
  classworkId    Int
  submissionDate DateTime?
  grade          String?
  feedback       String?
  submitted      Boolean   @default(false)
  attachments    String[]
  sendDate       DateTime?
  classTime      String?
  roomName       String?
  className      String?
  createdAt      DateTime? @default(now())
  updatedAt      DateTime? @updatedAt
  classwork      Classwork @relation(fields: [classworkId], references: [id], onDelete: Cascade)
  student        Student   @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([studentId, classworkId])
}

model GroupClasswork {
  id                    Int                     @id @default(autoincrement())
  termSubjectLevelId    Int
  title                 String
  description           String[]
  attachments           String[]
  isSent                Boolean                 @default(false)
  sendDate              DateTime                @default(now())
  createdAt             DateTime                @default(now())
  updatedAt             DateTime                @updatedAt
  studentId             Int
  teacherId             Int
  sectionId             Int?
  ClassworkSnapshot     ClassworkSnapshot[]
  section               Section?                @relation(fields: [sectionId], references: [id])
  student               Student                 @relation(fields: [studentId], references: [id], onDelete: Cascade)
  teacher               Teacher                 @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  termSubjectLevel      TermSubjectLevel        @relation(fields: [termSubjectLevelId], references: [id])
  SentClassworkSnapshot SentClassworkSnapshot[]
}

model ClassworkSnapshot {
  id               Int            @id @default(autoincrement())
  classworkId      Int
  groupClassworkId Int
  description      String
  attachments      String[]
  fileNames        String[]
  sendDate         DateTime       @default(now())
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  classwork        Classwork      @relation(fields: [classworkId], references: [id], onDelete: Cascade)
  groupClasswork   GroupClasswork @relation(fields: [groupClassworkId], references: [id], onDelete: Cascade)
}

model SentClassworkSnapshot {
  id               Int            @id @default(autoincrement())
  classworkId      Int?
  groupClassworkId Int
  description      String
  attachments      String[]
  fileNames        String[]
  sendDate         DateTime
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  classwork        Classwork?     @relation(fields: [classworkId], references: [id])
  groupClasswork   GroupClasswork @relation(fields: [groupClassworkId], references: [id])
}

model AutomatedMailForParents {
  id                 Int              @id @default(autoincrement())
  studentId          Int
  teacherId          Int
  termSubjectLevelId Int
  sectionId          Int
  className          String
  roomName           String
  isSent             Boolean          @default(false)
  sendDate           DateTime         @default(now())
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  classTime          String
  section            Section          @relation(fields: [sectionId], references: [id])
  student            Student          @relation(fields: [studentId], references: [id], onDelete: Cascade)
  teacher            Teacher          @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  termSubjectLevel   TermSubjectLevel @relation(fields: [termSubjectLevelId], references: [id])

  @@unique([studentId, termSubjectLevelId, sectionId, sendDate, teacherId])
}

model Interaction {
  id              Int             @id @default(autoincrement())
  studentId       Int
  interactionType InteractionType
  description     String?         @default("No comments")
  contactedDate   DateTime
  createdBy       Int
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  student         Student         @relation(fields: [studentId], references: [id], onDelete: Cascade)
}

model Comment {
  id              Int             @id @default(autoincrement())
  studentId       Int
  content         String
  createdBy       Int
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  interactionType InteractionType
  admin           Admin           @relation(fields: [createdBy], references: [id])
  student         Student         @relation(fields: [studentId], references: [id], onDelete: Cascade)
}

model Institution {
  id               Int      @id @default(autoincrement())
  name             String
  address          String
  logo             String
  contact          String
  email            String
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  contactSecondary String
  contactTertiary  String
  BSB              String?
  accountName      String?
  accountNumber    String?
}

model SchoolDay {
  id                 Int                       @id @default(autoincrement())
  schoolOperatedDate DateTime
  createdAt          DateTime                  @default(now())
  updatedAt          DateTime                  @updatedAt
  isOnSunday         Boolean                   @default(true)
  isOnWeekday        Boolean                   @default(false)
  classAttendances   ClassAttendance[]
  schoolAttendances  SchoolCheckInAttendance[]
}

model Leave {
  id            Int         @id @default(autoincrement())
  studentId     Int
  startDate     DateTime
  endDate       DateTime
  reason        String
  status        LeaveStatus @default(PENDING)
  appliedOn     DateTime    @default(now())
  approvedOn    DateTime?
  approverId    Int?
  comments      String?
  appliedById   Int
  appliedByRole Role
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  approver      Admin?      @relation(fields: [approverId], references: [id])
  student       Student     @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([studentId, startDate, endDate])
}

model EmailTemplate {
  id          Int      @id @default(autoincrement())
  name        String
  description String?
  subject     String
  text        String
  adminId     Int
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  admin       Admin    @relation(fields: [adminId], references: [id])
}

model EnrollmentConfirmationEmailTemplate {
  id          Int      @id @default(autoincrement())
  name        String
  description String?
  subject     String
  text        String
  adminId     Int
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  admin       Admin    @relation(fields: [adminId], references: [id])
}

model Notice {
  id               Int                     @id @default(autoincrement())
  title            String
  content          String
  adminId          Int
  createdAt        DateTime                @default(now())
  updatedAt        DateTime                @updatedAt
  admin            Admin                   @relation(fields: [adminId], references: [id])
  acknowledgements NoticeAcknowledgement[]
}

model NoticeAcknowledgement {
  id        Int       @id @default(autoincrement())
  noticeId  Int
  teacherId Int
  isSeen    Boolean   @default(false)
  seenAt    DateTime?
  notice    Notice    @relation(fields: [noticeId], references: [id], onDelete: Cascade)
  teacher   Teacher   @relation(fields: [teacherId], references: [id])

  @@unique([noticeId, teacherId])
}

model StudentNotice {
  id                     Int                            @id @default(autoincrement())
  title                  String
  content                String
  adminId                Int
  createdAt              DateTime                       @default(now())
  updatedAt              DateTime                       @updatedAt
  admin                  Admin                          @relation(fields: [adminId], references: [id])
  studentAcknowledgement StudentNoticeAcknowledgement[]
}

model StudentNoticeAcknowledgement {
  id              Int           @id @default(autoincrement())
  studentNoticeId Int
  studentId       Int
  isSeen          Boolean       @default(false)
  seenAt          DateTime?
  student         Student       @relation(fields: [studentId], references: [id], onDelete: Cascade)
  studentNotice   StudentNotice @relation(fields: [studentNoticeId], references: [id], onDelete: Cascade)

  @@unique([studentNoticeId, studentId])
}

model Event {
  id    Int          @id @default(autoincrement())
  start DateTime     @default(now())
  end   DateTime     @default(now())
  data  Appointment?
}

model Appointment {
  id          Int      @id @default(autoincrement())
  eventId     Int      @unique
  title       String
  color       String?
  isCompleted Boolean? @default(false)
  location    String?  @default("School")
  status      String?  @default("Melbourne")
  address     String?  @default("Langwarren")
  remarks     String?  @default("NA")
  type        String?  @default("Event")
  event       Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
}

model ClassRoom {
  id             Int             @id @default(autoincrement())
  name           String
  timetableSlots TimetableSlot[]
}

model TimeSlot {
  id             Int             @id @default(autoincrement())
  timeRange      String
  endTime        DateTime        @db.Time(6)
  startTime      DateTime        @db.Time(6)
  timetableSlots TimetableSlot[]
}

model TimetableSlot {
  id                 Int               @id @default(autoincrement())
  timetableId        Int
  classroomId        Int?
  timeSlotId         Int
  termSubjectLevelId Int?
  sectionId          Int?
  teacherId          Int?
  classroom          ClassRoom?        @relation(fields: [classroomId], references: [id], onDelete: Cascade)
  section            Section?          @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  teacher            Teacher?          @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  termSubjectLevel   TermSubjectLevel? @relation(fields: [termSubjectLevelId], references: [id], onDelete: Cascade)
  timeSlot           TimeSlot          @relation(fields: [timeSlotId], references: [id], onDelete: Cascade)
  timetable          Timetable         @relation(fields: [timetableId], references: [id], onDelete: Cascade)
}

model Timetable {
  id             Int             @id @default(autoincrement())
  name           String?         @default("Timetable")
  isActive       Boolean         @default(true)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  day            Day
  totalRooms     Int
  timetableSlots TimetableSlot[]
}

model EmailContent {
  id           Int      @id @default(autoincrement())
  studentId    Int
  emailcontent String
  sendDate     DateTime
  student      Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
}

model Message {
  id                  Int                   @id @default(autoincrement())
  content             String
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt
  senderId            Int
  status              MessageStatus         @default(SENT)
  messageType         MessageType
  StudentAdminMessage StudentAdminMessage[]
}

model StudentAdminMessage {
  id        Int     @id @default(autoincrement())
  studentId Int
  adminId   Int
  messageId Int
  admin     Admin   @relation(fields: [adminId], references: [id])
  message   Message @relation(fields: [messageId], references: [id])
  student   Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([studentId, adminId, messageId])
}

model AlumniRemarks {
  id        Int      @id @default(autoincrement())
  studentId Int
  remarks   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  student   Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
}

model Notification {
  id                 Int               @id @default(autoincrement())
  studentId          Int
  type               NotificationType
  title              String?
  content            String
  isRead             Boolean           @default(false)
  actionUrl          String?
  expiresAt          DateTime?
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
  sectionId          Int?
  termSubjectLevelId Int?
  section            Section?          @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  student            Student           @relation(fields: [studentId], references: [id], onDelete: Cascade)
  termSubjectLevel   TermSubjectLevel? @relation(fields: [termSubjectLevelId], references: [id], onDelete: Cascade)
}

model DeviceToken {
  id        Int      @id @default(autoincrement())
  studentId Int
  token     String   @unique
  platform  String
  lastSeen  DateTime @default(now())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  student   Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId])
}

model FeedbackCategory {
  id        Int                   @id @default(autoincrement())
  name      String                @unique
  isActive  Boolean               @default(true)
  createdAt DateTime              @default(now())
  updatedAt DateTime              @updatedAt
  options   AdminFeedbackOption[]
}

model AdminFeedbackOption {
  id         Int              @id @default(autoincrement())
  categoryId Int
  label      String?
  value      String
  isActive   Boolean          @default(true)
  order      Int              @default(0)
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt
  createdBy  Int
  category   FeedbackCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  admin      Admin            @relation(fields: [createdBy], references: [id])

  @@unique([categoryId, label])
}

enum Role {
  ADMIN
  TEACHER
  APPLICANT
  WAITLISTED
  STUDENT
  ALUMNI
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  EXCUSED
  LATE
  LEAVE
}

enum InteractionType {
  EMAIL
  MEETING
  PHONE_CALL
  MESSAGE
  CONFERENCE
  OTHER
  AUTOMATED_EMAIL
}

enum LeaveStatus {
  PENDING
  APPROVED
  DECLINED
}

enum PaymentMethod {
  ONLINE
  SCHOOL
  NA
  DISCOUNT
  CREDIT_CARD
  CASH
  OTHER
  CREDIT_BALANCE
}

enum PaymentStatus {
  PENDING
  PAID
  NODUES
  DUE
  OVERDUE
  FAILED
}

enum PaymentType {
  MONTHLY
  TERM
}

enum MessageType {
  STUDENT
  ADMIN
}

enum MessageStatus {
  SENT
  DELIVERED
  READ
  ERROR
}

enum Day {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}

enum NotificationType {
  FEE
  MESSAGE
  EVENT
  ATTENDANCE
  CLASSWORK
  HOMEWORK
  FEEDBACK
  FEEOVERDUE
}
