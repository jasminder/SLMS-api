<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <system.webServer>
        <rewrite>
            <rules>
                <rule name="ReqToIndexJs">
                    <match url=".*" />
                    <action type="Rewrite" url="dist/index.js" />
                </rule>
            </rules>
        </rewrite>
    </system.webServer>
</configuration>
